/* ==========================================
   NNSHS LIBRARY MANAGEMENT SYSTEM
   style.css
   Main Stylesheet
========================================== */

/* ===============================
   GOOGLE FONT
================================ */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');


/* ===============================
   RESET
================================ */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:'Poppins',sans-serif;

    background:#f7f9f8;

    color:#263238;

    line-height:1.7;

    overflow-x:hidden;

}

img{

    max-width:100%;

    display:block;

}

a{

    text-decoration:none;

    color:inherit;

}

ul{

    list-style:none;

}

button{

    font-family:'Poppins',sans-serif;

    cursor:pointer;

}

.container{

    width:90%;

    max-width:1300px;

    margin:auto;

}



/* ===============================
   COLORS
================================ */

:root{

    --primary:#1F5132;

    --secondary:#D4AF37;

    --accent:#4CAF50;

    --light:#ffffff;

    --background:#F7F9F8;

    --text:#263238;

    --gray:#6B7280;

    --shadow:0 15px 35px rgba(0,0,0,.08);

    --radius:18px;

}



/* ===============================
   BUTTONS
================================ */

.btn-primary{

    display:inline-flex;

    align-items:center;

    gap:10px;

    background:var(--primary);

    color:white;

    padding:14px 30px;

    border-radius:50px;

    font-weight:600;

    transition:.3s;

}

.btn-primary:hover{

    background:var(--secondary);

    color:#1f1f1f;

    transform:translateY(-3px);

}

.btn-secondary{

    display:inline-flex;

    align-items:center;

    gap:10px;

    border:2px solid var(--primary);

    color:var(--primary);

    padding:14px 30px;

    border-radius:50px;

    font-weight:600;

    transition:.3s;

}

.btn-secondary:hover{

    background:var(--primary);

    color:white;

}

.btn-outline{

    border:2px solid var(--primary);

    color:var(--primary);

    padding:10px 22px;

    border-radius:40px;

    font-weight:600;

    transition:.3s;

}

.btn-outline:hover{

    background:var(--primary);

    color:white;

}



/* ===============================
   HEADER
================================ */

header{

    position:fixed;

    top:0;

    left:0;

    width:100%;

    background:white;

    box-shadow:0 2px 15px rgba(0,0,0,.08);

    z-index:999;

}

.nav-container{

    display:flex;

    justify-content:space-between;

    align-items:center;

    height:85px;

}

.logo{

    display:flex;

    align-items:center;

    gap:15px;

}

.logo img{

    width:55px;

}

.logo h2{

    color:var(--primary);

    font-size:22px;

}

.logo span{

    color:var(--gray);

    font-size:13px;

}

nav ul{

    display:flex;

    gap:28px;

}

nav ul li a{

    font-weight:500;

    transition:.3s;

}

nav ul li a:hover,

nav ul li a.active{

    color:var(--secondary);

}

.menu-btn{

    display:none;

    font-size:24px;

    background:none;

    border:none;

}



/* ===============================
   HERO SECTION
================================ */

.hero{

    min-height:100vh;

    background:
        linear-gradient(
            rgba(20,55,35,.85),
            rgba(20,55,35,.80)
        ),
        url("../assets/library-bg.jpg");

    background-size:cover;

    background-position:center;

    display:flex;

    align-items:center;

    padding-top:100px;

}

.hero-content{

    display:grid;

    grid-template-columns:1fr 1fr;

    align-items:center;

    gap:60px;

}

.hero-text{

    color:white;

}

.hero-tag{

    display:inline-block;

    background:rgba(255,255,255,.15);

    padding:10px 18px;

    border-radius:30px;

    margin-bottom:25px;

    font-size:14px;

}

.hero h1{

    font-size:60px;

    line-height:1.2;

    margin-bottom:25px;

}

.hero p{

    font-size:18px;

    color:#ececec;

    margin-bottom:35px;

}

.hero-buttons{

    display:flex;

    gap:18px;

    flex-wrap:wrap;

}

.hero-image img{

    width:100%;

    animation:float 4s ease-in-out infinite;

}

@keyframes float{

    0%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-12px);
    }

    100%{
        transform:translateY(0);
    }

}
